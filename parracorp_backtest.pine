// =============================================================================
// ParraCorp v3.3 - EMA 35/50 Cross Strategy
// Compra cuando EMA35 cruza por encima de EMA50 + fuerza de mercado
// Vende cuando EMA35 cruza por debajo de EMA50 + fuerza de mercado
// =============================================================================

//@version=6
strategy("ParraCorp v3.3 EMA Cross", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=2, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     slippage=1, process_orders_on_close=true, calc_on_every_tick=false)

// =============================================================================
// INPUTS
// =============================================================================
grp_ema = "EMA Cross"
fast_len       = input.int(35, "EMA rapida", minval=5, maxval=100, group=grp_ema)
slow_len       = input.int(50, "EMA lenta", minval=10, maxval=200, group=grp_ema)
use_ema200     = input.bool(true, "Solo operar a favor de EMA200", group=grp_ema)

grp_force = "Fuerza de Mercado"
min_adx        = input.float(20, "ADX minimo", minval=0, maxval=50, step=1, group=grp_force, tooltip="Fuerza minima para confirmar el cruce")
use_macd       = input.bool(true, "MACD debe confirmar", group=grp_force)
use_volume     = input.bool(true, "Volumen por encima de media", group=grp_force)
min_separation = input.float(0.02, "Separacion EMAs minima %", minval=0, maxval=1.0, step=0.01, group=grp_force, tooltip="Las EMAs deben separarse para confirmar")

grp_risk = "Riesgo"
atr_sl         = input.float(1.5, "SL = ATR x", minval=0.5, maxval=4.0, step=0.1, group=grp_risk)
rr_min         = input.float(2.0, "R:R minimo", minval=1.0, maxval=5.0, step=0.1, group=grp_risk)
trailing_mode  = input.string("atr_dynamic", "Trailing", options=["none", "breakeven", "atr_trail", "atr_dynamic"], group=grp_risk)
max_trades     = input.int(3, "Max trades", minval=1, maxval=10, group=grp_risk)

grp_filter = "Filtros"
use_session    = input.bool(true, "Solo London+NY (7-20 UTC)", group=grp_filter)
use_rsi_filter = input.bool(true, "No entrar RSI extremo", group=grp_filter)
bars_after_cross = input.int(5, "Ventana de entrada tras cruce (barras)", minval=1, maxval=20, group=grp_filter, tooltip="Barras permitidas para entrar despues del cruce")

grp_visual = "Visual"
show_panel     = input.bool(true, "Panel info", group=grp_visual)

// =============================================================================
// INDICADORES
// =============================================================================
ema35  = ta.ema(close, fast_len)
ema50  = ta.ema(close, slow_len)
ema200 = ta.ema(close, 200)

// Distancia entre EMAs (fuerza del cruce)
ema_sep = math.abs(ema35 - ema50) / ema50 * 100

// RSI
rsi = ta.rsi(close, 14)

// MACD
[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)

// ADX + DI
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

// ATR
atr = ta.atr(14)
atr_pct = atr / close * 100

// Volume
vol_sma = ta.sma(volume, 20)
vol_ok = not use_volume or volume > vol_sma * 0.8

// Supertrend
hl2_val = (high + low) / 2
st_up_band = hl2_val + 3.0 * atr
st_lo_band = hl2_val - 3.0 * atr
var string st_dir = "UP"
var float st_line = 0.0
if st_dir == "UP"
    if close < st_lo_band
        st_dir := "DOWN"
        st_line := st_up_band
    else
        st_line := math.max(nz(st_line), st_lo_band)
else
    if close > st_up_band
        st_dir := "UP"
        st_line := st_lo_band
    else
        st_line := math.min(nz(st_line, 1e10), st_up_band)

// Stochastic
stoch_k = ta.stoch(close, high, low, 14)

// =============================================================================
// DETECCION DE CRUCE EMA 35/50
// =============================================================================
bool golden_cross = ta.crossover(ema35, ema50)    // EMA35 cruza ENCIMA de EMA50 = COMPRA
bool death_cross = ta.crossunder(ema35, ema50)     // EMA35 cruza DEBAJO de EMA50 = VENTA

// Barras desde el ultimo cruce (ventana de entrada)
var int bars_since_golden = 999
var int bars_since_death = 999

if golden_cross
    bars_since_golden := 0
    bars_since_death := 999
else
    bars_since_golden := bars_since_golden + 1

if death_cross
    bars_since_death := 0
    bars_since_golden := 999
else
    bars_since_death := bars_since_death + 1

// Estamos en ventana de entrada?
bool in_buy_window = bars_since_golden <= bars_after_cross
bool in_sell_window = bars_since_death <= bars_after_cross

// Estado de tendencia post-cruce
bool ema_bullish = ema35 > ema50  // EMA35 por encima = tendencia alcista
bool ema_bearish = ema35 < ema50  // EMA35 por debajo = tendencia bajista

// =============================================================================
// CONFIRMACION DE FUERZA
// =============================================================================
// ADX: hay fuerza en el mercado?
bool adx_strong = adx_val >= min_adx

// DI confirma direccion: +DI > -DI para BUY, -DI > +DI para SELL
bool di_buy = di_plus > di_minus
bool di_sell = di_minus > di_plus

// MACD confirma
bool macd_buy = not use_macd or macd_hist > 0 or (macd_hist > macd_hist[1] and macd_hist > macd_hist[2])
bool macd_sell = not use_macd or macd_hist < 0 or (macd_hist < macd_hist[1] and macd_hist < macd_hist[2])

// EMAs se estan separando (cruce con conviccion)
bool ema_separating = ema_sep >= min_separation

// EMA200: operar a favor de tendencia mayor
bool ema200_buy = not use_ema200 or na(ema200) or close > ema200
bool ema200_sell = not use_ema200 or na(ema200) or close < ema200

// RSI: no entrar agotado
bool rsi_buy_ok = not use_rsi_filter or rsi < 72
bool rsi_sell_ok = not use_rsi_filter or rsi > 28

// Sesion
int hour_utc = hour(time, "UTC")
bool session_ok = not use_session or (hour_utc >= 7 and hour_utc <= 20)

// Precio confirma: close por encima de ambas EMAs para BUY, por debajo para SELL
bool price_confirms_buy = close > ema35 and close > ema50
bool price_confirms_sell = close < ema35 and close < ema50

// =============================================================================
// SEÑALES
// =============================================================================
// ENTRADA 1: Cruce fresco + fuerza
bool entry_cross_buy = in_buy_window and adx_strong and di_buy and macd_buy and vol_ok and ema200_buy and rsi_buy_ok and session_ok and price_confirms_buy and ema_separating
bool entry_cross_sell = in_sell_window and adx_strong and di_sell and macd_sell and vol_ok and ema200_sell and rsi_sell_ok and session_ok and price_confirms_sell and ema_separating

// ENTRADA 2: Pullback a EMA35 en tendencia confirmada (post-cruce)
bool pullback_buy = ema_bullish and bars_since_golden > bars_after_cross and bars_since_golden < 50 and low <= ema35 * 1.001 and close > ema35 and close > open and adx_strong and di_buy and session_ok and ema200_buy
bool pullback_sell = ema_bearish and bars_since_death > bars_after_cross and bars_since_death < 50 and high >= ema35 * 0.999 and close < ema35 and close < open and adx_strong and di_sell and session_ok and ema200_sell

// ENTRADA 3: Reentrada cuando el precio vuelve a la zona despues de un pullback profundo a EMA50
bool reentry_buy = ema_bullish and bars_since_golden > 5 and low <= ema50 * 1.002 and close > ema50 and close > open and adx_val > 15 and rsi > 40 and rsi < 60 and session_ok
bool reentry_sell = ema_bearish and bars_since_death > 5 and high >= ema50 * 0.998 and close < ema50 and close < open and adx_val > 15 and rsi > 40 and rsi < 60 and session_ok

bool signal_buy = (entry_cross_buy or pullback_buy or reentry_buy) and strategy.opentrades < max_trades
bool signal_sell = (entry_cross_sell or pullback_sell or reentry_sell) and strategy.opentrades < max_trades

// =============================================================================
// SL / TP
// =============================================================================
float sl_dist = atr * atr_sl
float tp_dist = sl_dist * rr_min

float sl_price = na
float tp_price = na

if signal_buy
    sl_price := close - sl_dist
    tp_price := close + tp_dist
if signal_sell
    sl_price := close + sl_dist
    tp_price := close - tp_dist

// =============================================================================
// EJECUCION
// =============================================================================
var float entry_price = na
var float trade_sl = na
var float trade_tp = na
var string trade_dir = "NONE"
var float trade_risk = na

if signal_buy
    strategy.entry("BUY", strategy.long)
    entry_price := close
    trade_sl := sl_price
    trade_tp := tp_price
    trade_dir := "BUY"
    trade_risk := close - sl_price
    strategy.exit("X-BUY", "BUY", stop=sl_price, limit=tp_price)

if signal_sell
    strategy.entry("SELL", strategy.short)
    entry_price := close
    trade_sl := sl_price
    trade_tp := tp_price
    trade_dir := "SELL"
    trade_risk := sl_price - close
    strategy.exit("X-SELL", "SELL", stop=sl_price, limit=tp_price)

// Cerrar si el cruce se invierte (señal de salida natural)
if strategy.position_size > 0 and death_cross
    strategy.close("BUY", comment="Cross Exit")
if strategy.position_size < 0 and golden_cross
    strategy.close("SELL", comment="Cross Exit")

// =============================================================================
// TRAILING
// =============================================================================
if strategy.position_size != 0 and trailing_mode != "none"
    if trailing_mode == "breakeven"
        if trade_dir == "BUY" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            if close >= entry_price + trade_risk
                trade_sl := math.max(nz(trade_sl), entry_price)
                strategy.exit("X-BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            if close <= entry_price - trade_risk
                trade_sl := math.min(nz(trade_sl, 1e10), entry_price)
                strategy.exit("X-SELL", "SELL", stop=trade_sl, limit=trade_tp)

    else if trailing_mode == "atr_trail"
        if trade_dir == "BUY"
            trade_sl := math.max(nz(trade_sl), close - atr)
            strategy.exit("X-BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL"
            trade_sl := math.min(nz(trade_sl, 1e10), close + atr)
            strategy.exit("X-SELL", "SELL", stop=trade_sl, limit=trade_tp)

    else if trailing_mode == "atr_dynamic"
        float profit_r = 0.0
        if trade_dir == "BUY" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            profit_r := (close - entry_price) / trade_risk
        if trade_dir == "SELL" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            profit_r := (entry_price - close) / trade_risk
        float t_mult = profit_r > 3.0 ? 0.4 : profit_r > 2.0 ? 0.6 : profit_r > 1.0 ? 0.8 : 1.2
        if trade_dir == "BUY"
            trade_sl := math.max(nz(trade_sl), close - atr * t_mult)
            strategy.exit("X-BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL"
            trade_sl := math.min(nz(trade_sl, 1e10), close + atr * t_mult)
            strategy.exit("X-SELL", "SELL", stop=trade_sl, limit=trade_tp)

// Reset
if strategy.position_size == 0
    entry_price := na
    trade_sl := na
    trade_tp := na
    trade_dir := "NONE"
    trade_risk := na

// =============================================================================
// VISUAL
// =============================================================================
// EMAs principales
p_fast = plot(ema35, "EMA 35", color=color.new(color.aqua, 20), linewidth=2)
p_slow = plot(ema50, "EMA 50", color=color.new(color.orange, 20), linewidth=2)
plot(use_ema200 ? ema200 : na, "EMA 200", color=color.new(color.white, 50), linewidth=1)

// Fill entre EMAs (verde = alcista, rojo = bajista)
fill(p_fast, p_slow, color=ema35 > ema50 ? color.new(color.green, 85) : color.new(color.red, 85), title="EMA Fill")

// Supertrend
plot(st_line, "ST", color=st_dir == "UP" ? color.new(color.green, 50) : color.new(color.red, 50), linewidth=1, style=plot.style_linebr)

// Señales
plotshape(entry_cross_buy, "Cross BUY", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.normal, text="CROSS")
plotshape(entry_cross_sell, "Cross SELL", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.normal, text="CROSS")
plotshape(pullback_buy, "PB BUY", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.small, text="PB")
plotshape(pullback_sell, "PB SELL", shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size=size.small, text="PB")
plotshape(reentry_buy, "RE BUY", shape.circle, location.belowbar, color.new(color.teal, 0), size=size.tiny, text="RE")
plotshape(reentry_sell, "RE SELL", shape.circle, location.abovebar, color.new(color.maroon, 0), size=size.tiny, text="RE")

// Golden/Death cross markers
plotshape(golden_cross, "Golden Cross", shape.diamond, location.belowbar, color.new(color.yellow, 0), size=size.small)
plotshape(death_cross, "Death Cross", shape.diamond, location.abovebar, color.new(color.purple, 0), size=size.small)

// =============================================================================
// PANEL
// =============================================================================
if show_panel and barstate.islast
    var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_width=1)

    table.cell(t, 0, 0, "EMA 35/50", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, ema_bullish ? "ALCISTA" : "BAJISTA", text_color=ema_bullish ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 1, "Separacion", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(ema_sep, "#.###") + "%", text_color=ema_sep > min_separation ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 2, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(adx_val, "#.#"), text_color=adx_val >= min_adx ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 3, "+DI / -DI", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(di_plus, "#.#") + " / " + str.tostring(di_minus, "#.#"), text_color=di_plus > di_minus ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 4, "MACD hist", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(macd_hist, "#.####"), text_color=macd_hist > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 5, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(rsi, "#.#"), text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 6, "ATR%", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(atr_pct, "#.##") + "%", text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 7, "Ultimo cruce", text_color=color.gray, text_size=size.tiny)
    string cross_info = bars_since_golden < bars_since_death ? "Golden hace " + str.tostring(bars_since_golden) + "b" : "Death hace " + str.tostring(bars_since_death) + "b"
    table.cell(t, 1, 7, cross_info, text_color=color.yellow, text_size=size.tiny)

    table.cell(t, 0, 8, "SuperT", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8, st_dir, text_color=st_dir == "UP" ? color.green : color.red, text_size=size.tiny)

// =============================================================================
// ALERTAS
// =============================================================================
alertcondition(golden_cross, "Golden Cross 35/50", "EMA35 cruza ENCIMA de EMA50")
alertcondition(death_cross, "Death Cross 35/50", "EMA35 cruza DEBAJO de EMA50")
alertcondition(signal_buy, "BUY Signal", "Senal de COMPRA")
alertcondition(signal_sell, "SELL Signal", "Senal de VENTA")
