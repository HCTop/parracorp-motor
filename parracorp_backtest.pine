// =============================================================================
// ParraCorp Trading System v3.2 - High Frequency Quality Backtest
// Muchas operaciones buenas: trend-following + pullback entries + trailing
// =============================================================================
// Timeframes: 15m, 30m, 1H
// Pares: GBPJPY, GBPNZD, GBPAUD, EURJPY, EURNZD, GBPCAD, XAUUSD, EURUSD
// =============================================================================

//@version=6
strategy("ParraCorp v3.2", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=2, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     slippage=1, process_orders_on_close=true, calc_on_every_tick=false,
     max_bars_back=500)

// =============================================================================
// INPUTS
// =============================================================================
grp_entry = "Entrada"
tqs_umbral     = input.float(0.55, "TQS minimo", minval=0.1, maxval=1.0, step=0.05, group=grp_entry, tooltip="Mas bajo = mas trades")
rr_min         = input.float(1.5, "R:R minimo", minval=1.0, maxval=5.0, step=0.1, group=grp_entry)
atr_sl_mult    = input.float(1.2, "SL = ATR x", minval=0.5, maxval=3.0, step=0.1, group=grp_entry, tooltip="Multiplicador ATR para Stop Loss")
max_trades     = input.int(3, "Max trades simultaneos", minval=1, maxval=10, group=grp_entry)

grp_trend = "Tendencia"
ema_fast_len   = input.int(9, "EMA rapida", minval=3, maxval=20, group=grp_trend)
ema_mid_len    = input.int(21, "EMA media", minval=10, maxval=50, group=grp_trend)
ema_slow_len   = input.int(50, "EMA lenta", minval=30, maxval=100, group=grp_trend)
use_ema200     = input.bool(true, "Filtro EMA200", group=grp_trend)

grp_exit = "Salida"
trailing_mode  = input.string("atr_dynamic", "Trailing Stop", options=["none", "breakeven", "atr_trail", "atr_dynamic"], group=grp_exit, tooltip="atr_dynamic: trail se ajusta con la tendencia")
tp_partial     = input.bool(true, "Cerrar 50% en +1R", group=grp_exit, tooltip="Cierre parcial al alcanzar 1x riesgo")

grp_filter = "Filtros"
use_session    = input.bool(true, "Solo sesion London+NY", group=grp_filter)
use_macd_conf  = input.bool(true, "MACD debe confirmar", group=grp_filter)
use_rsi_filter = input.bool(true, "RSI no extremo (25-75)", group=grp_filter, tooltip="Evitar entrar en sobrecompra/sobreventa")
min_adx        = input.float(18, "ADX minimo", minval=0, maxval=50, step=1, group=grp_filter)
cooldown_bars  = input.int(3, "Cooldown tras cierre (barras)", minval=0, maxval=20, group=grp_filter, tooltip="Esperar N barras tras cerrar antes de reentrar")

grp_visual = "Visual"
show_emas      = input.bool(true, "Mostrar EMAs", group=grp_visual)
show_signals   = input.bool(true, "Mostrar senales", group=grp_visual)
show_panel     = input.bool(true, "Mostrar panel info", group=grp_visual)

// =============================================================================
// INDICADORES
// =============================================================================
ema_fast  = ta.ema(close, ema_fast_len)
ema_mid   = ta.ema(close, ema_mid_len)
ema_slow  = ta.ema(close, ema_slow_len)
ema200    = ta.ema(close, 200)
ema35     = ta.ema(close, 35)

// RSI
rsi = ta.rsi(close, 14)

// MACD
[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)

// ADX
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

// ATR
atr = ta.atr(14)
atr_pct = atr / close * 100

// Stochastic
stoch_k = ta.stoch(close, high, low, 14)

// Bollinger
[bb_mid, bb_upper, bb_lower] = ta.bb(close, 20, 2)

// Supertrend
hl2_val = (high + low) / 2
st_up_band = hl2_val + 3.0 * atr
st_lo_band = hl2_val - 3.0 * atr
var string st_dir = "UP"
var float st_line = 0.0
if st_dir == "UP"
    if close < st_lo_band
        st_dir := "DOWN"
        st_line := st_up_band
    else
        st_line := math.max(nz(st_line), st_lo_band)
else
    if close > st_up_band
        st_dir := "UP"
        st_line := st_lo_band
    else
        st_line := math.min(nz(st_line, 1e10), st_up_band)

// Volume
vol_sma = ta.sma(volume, 20)
vol_spike = volume > vol_sma * 1.3

// EMA 35/50 cross
ema50 = ta.ema(close, 50)
golden_cross = ta.crossover(ema35, ema50)
death_cross = ta.crossunder(ema35, ema50)

// =============================================================================
// DETECCION DE TENDENCIA
// =============================================================================
bool trend_up = ema_fast > ema_mid and ema_mid > ema_slow
bool trend_down = ema_fast < ema_mid and ema_mid < ema_slow
bool has_trend = trend_up or trend_down

// Fuerza de tendencia (slope EMA media normalizado)
float ema_slope = (ema_mid - ema_mid[5]) / ema_mid * 100
bool strong_trend = math.abs(ema_slope) > 0.05

// =============================================================================
// MOTOR 1: MOMENTUM (trend-following)
// =============================================================================
float mom_score = 0.0
string mom_dir = "NEUTRAL"

// Pullback a EMA en tendencia = entrada de alta probabilidad
bool pullback_buy = trend_up and low <= ema_mid * 1.001 and close > ema_mid and close > open
bool pullback_sell = trend_down and high >= ema_mid * 0.999 and close < ema_mid and close < open

// Continuation: precio rebota de EMA rapida en tendencia fuerte
bool continuation_buy = trend_up and strong_trend and low <= ema_fast * 1.002 and close > ema_fast
bool continuation_sell = trend_down and strong_trend and high >= ema_fast * 0.998 and close < ema_fast

if pullback_buy or continuation_buy
    mom_score := pullback_buy ? 0.8 : 0.6
    mom_dir := "BUY"
else if pullback_sell or continuation_sell
    mom_score := pullback_sell ? 0.8 : 0.6
    mom_dir := "SELL"
else if trend_up and close > ema_fast and macd_hist > macd_hist[1]
    mom_score := 0.4
    mom_dir := "BUY"
else if trend_down and close < ema_fast and macd_hist < macd_hist[1]
    mom_score := 0.4
    mom_dir := "SELL"

// =============================================================================
// MOTOR 2: BREAKOUT (rotura de rango)
// =============================================================================
float brk_score = 0.0
string brk_dir = "NEUTRAL"

float highest20 = ta.highest(high, 20)
float lowest20 = ta.lowest(low, 20)
bool breakout_up = close > highest20[1] and vol_spike and adx_val > 20
bool breakout_down = close < lowest20[1] and vol_spike and adx_val > 20

if breakout_up
    brk_score := 0.7
    brk_dir := "BUY"
else if breakout_down
    brk_score := 0.7
    brk_dir := "SELL"

// =============================================================================
// MOTOR 3: MEAN REVERSION (solo en rango, no contra tendencia)
// =============================================================================
float rev_score = 0.0
string rev_dir = "NEUTRAL"

bool ranging = not has_trend and adx_val < 25
float zscore = 0.0
float std50 = ta.stdev(close, 50)
float mean50 = ta.sma(close, 50)
if std50 > 0
    zscore := (close - mean50) / std50

if ranging
    if zscore < -1.5 and rsi < 35 and stoch_k < 25
        rev_score := 0.7
        rev_dir := "BUY"
    else if zscore > 1.5 and rsi > 65 and stoch_k > 75
        rev_score := 0.7
        rev_dir := "SELL"

// =============================================================================
// MOTOR 4: DIVERGENCIA RSI
// =============================================================================
float div_bonus = 0.0

// Divergencia alcista: precio nuevo minimo, RSI no
float price_low_now = ta.lowest(low, 10)
float price_low_prev = ta.lowest(low[10], 10)
float rsi_low_now = ta.lowest(rsi, 10)
float rsi_low_prev = ta.lowest(rsi[10], 10)
bool bull_div = price_low_now < price_low_prev and rsi_low_now > rsi_low_prev

// Divergencia bajista: precio nuevo maximo, RSI no
float price_hi_now = ta.highest(high, 10)
float price_hi_prev = ta.highest(high[10], 10)
float rsi_hi_now = ta.highest(rsi, 10)
float rsi_hi_prev = ta.highest(rsi[10], 10)
bool bear_div = price_hi_now > price_hi_prev and rsi_hi_now < rsi_hi_prev

if bull_div and (mom_dir == "BUY" or rev_dir == "BUY")
    div_bonus := 0.15
if bear_div and (mom_dir == "SELL" or rev_dir == "SELL")
    div_bonus := 0.15

// =============================================================================
// TQS (Trade Quality Score)
// =============================================================================
// Mejor motor gana, bonus por coincidencia
float best_buy = math.max(mom_dir == "BUY" ? mom_score : 0, math.max(brk_dir == "BUY" ? brk_score : 0, rev_dir == "BUY" ? rev_score : 0))
float best_sell = math.max(mom_dir == "SELL" ? mom_score : 0, math.max(brk_dir == "SELL" ? brk_score : 0, rev_dir == "SELL" ? rev_score : 0))

// Contar motores de acuerdo
int agree_buy = (mom_dir == "BUY" ? 1 : 0) + (brk_dir == "BUY" ? 1 : 0) + (rev_dir == "BUY" ? 1 : 0)
int agree_sell = (mom_dir == "SELL" ? 1 : 0) + (brk_dir == "SELL" ? 1 : 0) + (rev_dir == "SELL" ? 1 : 0)

// Bonus por consenso (+0.1 por cada motor adicional)
float consensus_bonus_buy = math.max(0, (agree_buy - 1)) * 0.1
float consensus_bonus_sell = math.max(0, (agree_sell - 1)) * 0.1

float tqs_buy = best_buy + consensus_bonus_buy + (bull_div ? div_bonus : 0)
float tqs_sell = best_sell + consensus_bonus_sell + (bear_div ? div_bonus : 0)

float tqs = math.max(tqs_buy, tqs_sell)
string direccion = "NEUTRAL"
if tqs_buy > tqs_sell and tqs_buy >= tqs_umbral
    direccion := "BUY"
else if tqs_sell > tqs_buy and tqs_sell >= tqs_umbral
    direccion := "SELL"

// =============================================================================
// FILTROS
// =============================================================================
// Sesion
int hour_utc = hour(time, "UTC")
bool in_session = not use_session or (hour_utc >= 7 and hour_utc <= 20)

// MACD confirma direccion
bool macd_ok = not use_macd_conf
if use_macd_conf
    if direccion == "BUY"
        macd_ok := macd_hist > 0 or macd_hist > macd_hist[1]  // positivo O mejorando
    else if direccion == "SELL"
        macd_ok := macd_hist < 0 or macd_hist < macd_hist[1]

// RSI no en extremo (evitar entrar en agotamiento)
bool rsi_ok = not use_rsi_filter or (rsi > 25 and rsi < 75)

// ADX
bool adx_ok = adx_val >= min_adx

// EMA200
bool ema200_ok = not use_ema200 or na(ema200)
if use_ema200 and not na(ema200)
    if direccion == "BUY"
        ema200_ok := close > ema200
    else if direccion == "SELL"
        ema200_ok := close < ema200

// Cooldown: no reentrar inmediatamente tras cerrar
var int bars_since_close = 100
if strategy.closedtrades > 0 and strategy.closedtrades != strategy.closedtrades[1]
    bars_since_close := 0
else
    bars_since_close := bars_since_close + 1
bool cooldown_ok = bars_since_close >= cooldown_bars

// Supertrend concordante (soft: solo bonus, no bloquea)
bool st_agrees = (direccion == "BUY" and st_dir == "UP") or (direccion == "SELL" and st_dir == "DOWN")
if st_agrees
    tqs := math.min(tqs + 0.05, 1.0)

// Golden/Death cross bonus
if golden_cross and direccion == "BUY"
    tqs := math.min(tqs + 0.1, 1.0)
if death_cross and direccion == "SELL"
    tqs := math.min(tqs + 0.1, 1.0)

// =============================================================================
// SL / TP
// =============================================================================
float sl_dist = atr * atr_sl_mult
float tp_dist = sl_dist * rr_min

float sl_price = na
float tp_price = na

if direccion == "BUY"
    sl_price := close - sl_dist
    tp_price := close + tp_dist
else if direccion == "SELL"
    sl_price := close + sl_dist
    tp_price := close - tp_dist

float rr_actual = not na(sl_price) and math.abs(close - sl_price) > 0 ? math.abs(tp_price - close) / math.abs(close - sl_price) : 0
bool rr_ok = rr_actual >= rr_min

// =============================================================================
// SEÑALES DE ENTRADA
// =============================================================================
bool all_filters = in_session and macd_ok and rsi_ok and adx_ok and ema200_ok and cooldown_ok and rr_ok
bool signal_buy = direccion == "BUY" and tqs >= tqs_umbral and all_filters and strategy.opentrades < max_trades
bool signal_sell = direccion == "SELL" and tqs >= tqs_umbral and all_filters and strategy.opentrades < max_trades

// =============================================================================
// EJECUCION
// =============================================================================
var float entry_price = na
var float trade_sl = na
var float trade_tp = na
var string trade_dir = "NONE"
var float trade_risk = na

if signal_buy
    strategy.entry("BUY", strategy.long)
    entry_price := close
    trade_sl := sl_price
    trade_tp := tp_price
    trade_dir := "BUY"
    trade_risk := close - sl_price
    strategy.exit("Exit BUY", "BUY", stop=sl_price, limit=tp_price)

if signal_sell
    strategy.entry("SELL", strategy.short)
    entry_price := close
    trade_sl := sl_price
    trade_tp := tp_price
    trade_dir := "SELL"
    trade_risk := sl_price - close
    strategy.exit("Exit SELL", "SELL", stop=sl_price, limit=tp_price)

// =============================================================================
// TRAILING STOP DINAMICO
// =============================================================================
if strategy.position_size != 0 and trailing_mode != "none"
    if trailing_mode == "breakeven"
        // Mover SL a entrada cuando gana +1R
        if trade_dir == "BUY" and not na(entry_price) and not na(trade_risk)
            if close >= entry_price + trade_risk
                trade_sl := math.max(nz(trade_sl), entry_price + atr * 0.1)
                strategy.exit("Exit BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL" and not na(entry_price) and not na(trade_risk)
            if close <= entry_price - trade_risk
                trade_sl := math.min(nz(trade_sl, 1e10), entry_price - atr * 0.1)
                strategy.exit("Exit SELL", "SELL", stop=trade_sl, limit=trade_tp)

    else if trailing_mode == "atr_trail"
        // SL sigue a 1 ATR del precio
        if trade_dir == "BUY"
            float new_sl = close - atr
            trade_sl := math.max(nz(trade_sl), new_sl)
            strategy.exit("Exit BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL"
            float new_sl = close + atr
            trade_sl := math.min(nz(trade_sl, 1e10), new_sl)
            strategy.exit("Exit SELL", "SELL", stop=trade_sl, limit=trade_tp)

    else if trailing_mode == "atr_dynamic"
        // Trail se estrecha conforme el trade gana (protege mas)
        float profit_r = 0.0
        if trade_dir == "BUY" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            profit_r := (close - entry_price) / trade_risk
        if trade_dir == "SELL" and not na(entry_price) and not na(trade_risk) and trade_risk > 0
            profit_r := (entry_price - close) / trade_risk

        // A mas ganancia, trail mas ajustado
        float trail_mult = profit_r > 2.0 ? 0.5 : profit_r > 1.0 ? 0.75 : 1.0
        if trade_dir == "BUY"
            float new_sl = close - atr * trail_mult
            trade_sl := math.max(nz(trade_sl), new_sl)
            strategy.exit("Exit BUY", "BUY", stop=trade_sl, limit=trade_tp)
        if trade_dir == "SELL"
            float new_sl = close + atr * trail_mult
            trade_sl := math.min(nz(trade_sl, 1e10), new_sl)
            strategy.exit("Exit SELL", "SELL", stop=trade_sl, limit=trade_tp)

// Reset on flat
if strategy.position_size == 0
    entry_price := na
    trade_sl := na
    trade_tp := na
    trade_dir := "NONE"
    trade_risk := na

// =============================================================================
// VISUAL
// =============================================================================
// EMAs
plot(show_emas ? ema_fast : na, "EMA Fast", color=color.new(color.yellow, 40), linewidth=1)
plot(show_emas ? ema_mid : na, "EMA Mid", color=color.new(color.orange, 40), linewidth=1)
plot(show_emas ? ema_slow : na, "EMA Slow", color=color.new(color.blue, 40), linewidth=2)
plot(show_emas ? ema200 : na, "EMA 200", color=color.new(color.white, 50), linewidth=2)

// Supertrend
color st_color = st_dir == "UP" ? color.new(color.green, 40) : color.new(color.red, 40)
plot(st_line, "Supertrend", color=st_color, linewidth=2, style=plot.style_linebr)

// Signals
plotshape(show_signals and signal_buy, "BUY", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(show_signals and signal_sell, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Pullback zones
plotshape(show_signals and pullback_buy and not signal_buy, "Pullback BUY zone", shape.circle, location.belowbar, color.new(color.lime, 70), size=size.tiny)
plotshape(show_signals and pullback_sell and not signal_sell, "Pullback SELL zone", shape.circle, location.abovebar, color.new(color.fuchsia, 70), size=size.tiny)

// Divergences
plotshape(show_signals and bull_div, "Bull Div", shape.diamond, location.belowbar, color.new(color.aqua, 30), size=size.tiny)
plotshape(show_signals and bear_div, "Bear Div", shape.diamond, location.abovebar, color.new(color.orange, 30), size=size.tiny)

// Trend background
bgcolor(trend_up ? color.new(color.green, 95) : trend_down ? color.new(color.red, 95) : na, title="Trend BG")

// Volume spike
bgcolor(vol_spike ? color.new(color.blue, 92) : na, title="Volume Spike")

// =============================================================================
// PANEL INFO
// =============================================================================
if show_panel and barstate.islast
    var table p = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 20), border_width=1)

    color tqs_col = tqs >= tqs_umbral ? color.green : color.red
    table.cell(p, 0, 0, "TQS", text_color=color.white, text_size=size.small)
    table.cell(p, 1, 0, str.tostring(tqs, "#.##"), text_color=tqs_col, text_size=size.small)

    table.cell(p, 0, 1, "Trend", text_color=color.gray, text_size=size.tiny)
    string trend_txt = trend_up ? "UP" : trend_down ? "DOWN" : "RANGE"
    color trend_col = trend_up ? color.green : trend_down ? color.red : color.yellow
    table.cell(p, 1, 1, trend_txt, text_color=trend_col, text_size=size.tiny)

    table.cell(p, 0, 2, "Momentum", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 2, str.tostring(mom_score, "#.##") + " " + mom_dir, text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 3, "Breakout", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 3, str.tostring(brk_score, "#.##") + " " + brk_dir, text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 4, "Reversion", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 4, str.tostring(rev_score, "#.##") + " " + rev_dir, text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 5, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 5, str.tostring(rsi, "#.#"), text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 6, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 6, str.tostring(adx_val, "#.#"), text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 7, "ATR%", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 7, str.tostring(atr_pct, "#.##") + "%", text_color=color.white, text_size=size.tiny)

    table.cell(p, 0, 8, "SuperT", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 8, st_dir, text_color=st_dir == "UP" ? color.green : color.red, text_size=size.tiny)

    table.cell(p, 0, 9, "Dir", text_color=color.gray, text_size=size.tiny)
    color d_col = direccion == "BUY" ? color.green : direccion == "SELL" ? color.red : color.gray
    table.cell(p, 1, 9, direccion, text_color=d_col, text_size=size.tiny)

// =============================================================================
// ALERTAS
// =============================================================================
alertcondition(signal_buy, "ParraCorp BUY", "BUY Signal - TQS={{plot_0}}")
alertcondition(signal_sell, "ParraCorp SELL", "SELL Signal - TQS={{plot_0}}")
alertcondition(golden_cross, "Golden Cross", "EMA35 cruza encima EMA50")
alertcondition(death_cross, "Death Cross", "EMA35 cruza debajo EMA50")
